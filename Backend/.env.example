# CampusServe backend. Copy to Backend/.env (never commit it). Server-side only.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres connection (Supabase: Project Settings -> Database -> connection string, session pooler).
# The connecting role must be able to SET ROLE authenticated / service_role (Supabase's `postgres` role can).
DATABASE_URL=
DATABASE_SSL=true
# Supabase database CA certificate (Database -> Settings -> SSL configuration -> Download certificate).
DATABASE_SSL_CA_FILE=./prod-ca-2021.crt
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Token verification: SUPABASE_URL (JWKS at /auth/v1/.well-known/jwks.json) and/or the legacy JWT secret.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_JWT_SECRET=
JWT_AUDIENCE=authenticated

# Storage (private buckets; signed URLs only). Service-role key: backend only, never the browser.
STORAGE_MODE=supabase
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
# Number of proxies in front of the API (e.g. 1 on Render) so client IPs are correct for rate limiting.
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=120
PUBLIC_RATE_LIMIT_PER_MINUTE=30

# Payments: no real provider is integrated. The sandbox simulates one for DEVELOPMENT ONLY
# (refused when NODE_ENV=production). The database setting payments.enabled_providers must also list it.
PAYMENT_SANDBOX=false
PAYMENT_SANDBOX_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/student/payments

# AI: the seeded provider is "mock" (no key). For a real OpenAI-compatible provider, map its code to a base
# URL here and put its key in the env var named by ai_provider_settings.secret_ref.
AI_PROVIDER_BASE_URLS={}

WORKER_POLL_MS=15000
