# CampusServe environment variables. Copy to .env and fill in. Never commit .env.
# Keys: Supabase dashboard -> Project Settings -> API.

# --- Backend (server only) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. Backend only; never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Applying migrations from a terminal (contains the database password) ---
SUPABASE_DB_URL=

# --- Frontend (public; Vite exposes only VITE_ variables) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Payment provider credentials (GCash, Maya, LANDBANK) will be added here, backend only,
# after merchant onboarding. No provider is integrated yet.
