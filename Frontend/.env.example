# Frontend (public values only; Vite exposes VITE_ variables to the browser).
# Never put the service-role key or any secret here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
# Backend base URL. Leave empty in local development (Vite proxies /api to :4000).
VITE_API_URL=
# Local development only: accept a developer token from localStorage instead of Supabase sign-in.
# Ignored in production builds.
VITE_DEV_AUTH=false
